// use prisma-8

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  REWARD
  REFERRAL_COMMISSION
  REFUND
  ADJUSTMENT
}

enum PaymentMethodType {
  EASYPAISA
  JAZZCASH
  BANK
  CRYPTO
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model User {
  id           String     @id @default(cuid(2))
  fullName     String
  username     String     @unique
  email        String     @unique
  phone        String     @unique
  passwordHash String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  balance         BigInt @default(0)
  totalDeposit    BigInt @default(0)
  totalWithdrawal BigInt @default(0)
  totalReward     BigInt @default(0)
  totalCommission BigInt @default(0)

  referralCode String @unique
  referredById String?

  referredBy User?  @relation("UserReferral", fields: [referredById], references: [id])
  referrals  User[] @relation("UserReferral")

  investments Investment[]
  deposits    Deposit[]
  withdrawals Withdrawal[]
  commissions Commission[]
  transactions Transaction[]

  supportTickets SupportTicket[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([referredById])
  @@index([status])
  @@index([createdAt])
}

model Plan {
  id String @id @default(cuid(2))

  name String

  investmentAmount BigInt
  rewardAmount     BigInt

  durationDays Int?

  isActive Boolean @default(true)

  investments Investment[]

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([isActive])
}

model Investment {
  id String @id @default(cuid(2))

  userId String
  planId String

  amount BigInt
  reward BigInt

  status InvestmentStatus @default(ACTIVE)

  startedAt DateTime @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model Deposit {
  id String @id @default(cuid(2))

  userId String

  amount BigInt

  method PaymentMethodType

  transactionId String?
  screenshotUrl String?

  status DepositStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id String @id @default(cuid(2))

  userId String

  amount BigInt

  method PaymentMethodType

  accountName   String?
  accountNumber String

  status WithdrawalStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum CommissionType {
  INVESTMENT
  PROFIT
}

model Commission {
  id String @id @default(cuid(2))

  userId       String
  sourceUserId String

  investmentId String?

  level        Int
  type         CommissionType

  percentageBps Int
  amount        BigInt

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sourceUserId])
  @@index([investmentId])
  @@index([level])
  @@index([type])
}

model Rank {
  id String @id @default(cuid(2))

  level Int @unique
  name  String

  minOwnInvestment      BigInt @default(0)
  minReferralInvestment BigInt

  bonus BigInt @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([level])
  @@index([isActive])
}

model Transaction {
  id String @id @default(cuid(2))

  userId String

  type TransactionType
  amount BigInt

  note String?

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model PaymentMethod {
  id String @id @default(cuid(2))

  name String
  type PaymentMethodType

  accountName  String?
  accountNumber String?
  instructions String?

  isAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}


model News {
  id String @id @default(cuid(2))

  title String
  slug  String @unique
  content String

  imageUrl String?

  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([published])
}

model SupportTicket {
  id String @id @default(cuid(2))

  userId String

  subject String
  message String

  status SupportStatus @default(OPEN)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([userId])
  @@index([status])
}

model Notification {
  id String @id @default(cuid(2))

  userId String

  title   String
  message String

  isRead Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}